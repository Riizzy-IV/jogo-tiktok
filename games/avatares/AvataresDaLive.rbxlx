<Item class="Lighting" referent="RBX69"><Properties><string name="Name">Lighting</string><string name="TimeOfDay">20:45:00</string><float name="Brightness">1.2</float><float name="ExposureCompensation">0</float><Color3 name="Ambient"><R>0.27450980392156865</R><G>0.23529411764705882</G><B>0.4117647058823529</B></Color3><Color3 name="OutdoorAmbient"><R>0.37254901960784315</R><G>0.3333333333333333</G><B>0.5490196078431373</B></Color3><bool name="GlobalShadows">true</bool><token name="Technology">4</token><float name="EnvironmentDiffuseScale">1</float><float name="EnvironmentSpecularScale">1</float></Properties><Item class="Atmosphere" referent="RBX66"><Properties><string name="Name">Atmosphere</string><float name="Density">0.32</float><float name="Offset">0.2</float><Color3 name="Color"><R>0.43137254901960786</R><G>0.27450980392156865</G><B>0.6666666666666666</B></Color3><Color3 name="Decay"><R>0.27450980392156865</R><G>0.11764705882352941</G><B>0.47058823529411764</B></Color3><float name="Glare">0</float><float name="Haze">1.4</float></Properties></Item><Item class="BloomEffect" referent="RBX67"><Properties><string name="Name">Brilho</string><float name="Intensity">0.4</float><float name="Size">24</float><float name="Threshold">1.8</float></Properties></Item><Item class="ColorCorrectionEffect" referent="RBX68"><Properties><string name="Name">Cores</string><float name="Saturation">0.15</float><float name="Contrast">0.1</float></Properties></Item></Item>
